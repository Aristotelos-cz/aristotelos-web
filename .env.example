# Produkční adresa webu (canonical, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://aristotelos.com

# Indexování vyhledávači: on nebo off. Bez nastavení rozhoduje doména, viz docs/nasazeni-a-kontroly.md
# SITE_INDEXING=

# Sanity (nejsou tajné, objevují se i ve veřejném kódu; kód je zatím nepoužívá)
NEXT_PUBLIC_SANITY_PROJECT_ID=kgbqsodt
NEXT_PUBLIC_SANITY_DATASET=production

# Odesílání e-mailů z formulářů přes Microsoft 365 (Microsoft Graph), viz docs/formulare-a-emaily.md
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Schránka, ze které web posílá
MAIL_FROM=info@aristotelos.com
# Kam chodí žádosti z formulářů (víc adres oddělte čárkou), bez nastavení info@aristotelos.com
LEAD_EMAIL_TO=
